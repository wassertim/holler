#!/bin/sh
#
# Husky commit-msg hook for Holler
# Blocks commits containing Claude Code attribution
#

# Get the commit message file
COMMIT_MSG_FILE=$1

# Read the commit message
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check for forbidden patterns
check_pattern() {
    pattern="$1"
    if echo "$COMMIT_MSG" | grep -qiE "$pattern"; then
        echo ""
        echo "╔════════════════════════════════════════════════════════════════╗"
        echo "║  ❌ COMMIT REJECTED: Claude Attribution Detected              ║"
        echo "╚════════════════════════════════════════════════════════════════╝"
        echo ""
        echo "Forbidden pattern found: $pattern"
        echo ""
        echo "Per CLAUDE.md rules, the following are ABSOLUTELY FORBIDDEN:"
        echo "  ❌ \"Generated with [Claude Code](https://claude.ai/code)\""
        echo "  ❌ \"Co-Authored-By: Claude <noreply@anthropic.com>\""
        echo "  ❌ Any mention of AI assistance or automated generation"
        echo "  ❌ Any reference to Claude, AI, or automated code generation"
        echo ""
        echo "Your commit message:"
        echo "┌────────────────────────────────────────────────────────────────┐"
        echo "$COMMIT_MSG" | sed 's/^/│ /'
        echo "└────────────────────────────────────────────────────────────────┘"
        echo ""
        echo "Please remove all Claude attribution and try again."
        echo ""
        exit 1
    fi
}

# Check each forbidden pattern
check_pattern "Generated with.*Claude Code"
check_pattern "claude\.com/claude-code"
check_pattern "claude\.ai/code"
check_pattern "Co-Authored-By:.*Claude.*<noreply@anthropic\.com>"
check_pattern "Co-Authored-By:.*Claude"
check_pattern "AI-generated"
check_pattern "Generated by AI"
check_pattern "Claude Code"
check_pattern "🤖.*Claude"

# All checks passed
exit 0
