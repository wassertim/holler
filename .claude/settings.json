{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": ["~/projects", "~/Library/Logs"],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs"
    ],
    "deny": [
      "Bash(killall Dock)",
      "Bash(killall Finder)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo:*)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
